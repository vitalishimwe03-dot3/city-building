<section class="hero" id="home">
  <div class="hero-slider" id="heroSlider" aria-roledescription="carousel" aria-label="Featured images"></div>
  <button type="button" class="hero-slider-arrow prev" id="heroPrev" aria-label="Previous slide">
    <i class="bi bi-chevron-left"></i>
  </button>
  <button type="button" class="hero-slider-arrow next" id="heroNext" aria-label="Next slide">
    <i class="bi bi-chevron-right"></i>
  </button>
  <div class="hero-slider-dots" id="heroDots" role="tablist" aria-label="Choose slide"></div>
  <div class="hero-slider-progress" aria-hidden="true"><span id="heroProgressBar"></span></div>
  <div class="container">
    <div class="row align-items-center" style="min-height: 90vh;">
      <div class="col-12 col-lg-7">
        <div class="hero-badge">
          <i class="bi bi-geo-alt-fill"></i>
          Kigali, Rwanda — May 2026 Intake
        </div>
        <h1 class="hero-title">
          Build Your <span class="highlight">Engineering</span> Career
        </h1>
        <p class="hero-subtitle">
          Professional software training in AutoCAD, Revit, ETABS, Lumion and more.
          Hands-on courses designed for architects, engineers, and designers in Rwanda.
        </p>
        <div class="hero-actions">
          <a href="/category/architecture" class="btn btn-primary btn-lg">
            <i class="bi bi-compass"></i> Explore Courses
          </a>
          <a href="/contact" class="btn btn-outline btn-lg">
            <i class="bi bi-chat-dots"></i> Enquire Now
          </a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat">
            <h3>10+</h3>
            <p>Courses</p>
          </div>
          <div class="hero-stat">
            <h3>500+</h3>
            <p>Graduates</p>
          </div>
          <div class="hero-stat">
            <h3>5★</h3>
            <p>Training</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var hero = document.getElementById('home');
  var container = document.getElementById('heroSlider');
  var dotsContainer = document.getElementById('heroDots');
  var prevBtn = document.getElementById('heroPrev');
  var nextBtn = document.getElementById('heroNext');
  var progressBar = document.getElementById('heroProgressBar');
  if (!hero || !container || !dotsContainer) return;

  var fallbackSlides = [
    'https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=1920&q=85',
    'https://images.unsplash.com/photo-1486325212027-8081e485255e?w=1920&q=85',
    'https://images.unsplash.com/photo-1503387762519-52582b8ba3f0?w=1920&q=85',
    'https://images.unsplash.com/photo-1518005020951-eccb494ad742?w=1920&q=85',
    'https://images.unsplash.com/photo-1541888946425-d81bb218711f?w=1920&q=85'
  ];

  var slides = [];
  var current = -1;
  var timer = null;
  var hovering = false;
  var touchStartX = null;

  function normalize(list) {
    if (!Array.isArray(list)) return [];
    return list.map(function (item) {
      if (!item) return null;
      var image = item.image || item.image_path;
      if (!image) return null;
      return {
        image: image,
        image_alt: item.image_alt || item.title || 'City Building Engineering',
        animation: item.animation || 'fade',
        transition_speed: Math.max(1500, parseInt(item.transition_speed, 10) || 5000),
        auto_play: item.auto_play === undefined ? 1 : Number(item.auto_play)
      };
    }).filter(Boolean);
  }

  function build(list) {
    slides = normalize(list);
    if (!slides.length) {
      slides = normalize(fallbackSlides.map(function (src) {
        return { image: src, animation: 'fade', transition_speed: 5000, auto_play: 1 };
      }));
    }

    container.innerHTML = '';
    dotsContainer.innerHTML = '';

    slides.forEach(function (item, i) {
      var slide = document.createElement('div');
      slide.className = 'hero-slide';
      slide.setAttribute('data-animation', item.animation);
      slide.setAttribute('role', 'group');
      slide.setAttribute('aria-roledescription', 'slide');
      slide.setAttribute('aria-label', (i + 1) + ' of ' + slides.length);
      slide.setAttribute('aria-hidden', 'true');

      var img = document.createElement('img');
      img.className = 'hero-slide-img';
      img.src = item.image;
      img.alt = item.image_alt;
      img.decoding = 'async';
      img.loading = i === 0 ? 'eager' : 'lazy';
      img.addEventListener('error', function () {
        img.style.display = 'none';
        slide.classList.add('hero-slide--error');
      });
      slide.appendChild(img);
      container.appendChild(slide);

      var dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'dot';
      dot.setAttribute('role', 'tab');
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      dot.addEventListener('click', function () { goTo(i); });
      dotsContainer.appendChild(dot);
    });

    var multiple = slides.length > 1;
    if (prevBtn) prevBtn.style.display = multiple ? '' : 'none';
    if (nextBtn) nextBtn.style.display = multiple ? '' : 'none';
    dotsContainer.style.display = multiple ? '' : 'none';

    goTo(0);
  }

  function goTo(index) {
    if (!slides.length) return;
    index = ((index % slides.length) + slides.length) % slides.length;

    var els = container.querySelectorAll('.hero-slide');
    var dots = dotsContainer.querySelectorAll('.dot');

    for (var i = 0; i < els.length; i++) {
      var active = i === index;
      els[i].classList.toggle('active', active);
      els[i].setAttribute('aria-hidden', active ? 'false' : 'true');
    }
    for (var j = 0; j < dots.length; j++) {
      var isActive = j === index;
      dots[j].classList.toggle('active', isActive);
      dots[j].setAttribute('aria-selected', isActive ? 'true' : 'false');
    }

    current = index;
    restartProgress();
    startTimer();
  }

  function startTimer() {
    if (timer) { clearTimeout(timer); timer = null; }
    if (hovering || document.hidden || slides.length < 2) return;
    var slide = slides[current];
    if (!slide || slide.auto_play === 0) return;
    timer = setTimeout(function () { goTo(current + 1); }, slide.transition_speed);
  }

  function restartProgress() {
    if (!progressBar) return;
    progressBar.style.animation = 'none';
    void progressBar.offsetWidth;
    var slide = slides[current];
    if (slides.length > 1 && slide && slide.auto_play !== 0 && !hovering && !document.hidden) {
      progressBar.style.animation = 'heroProgress ' + slide.transition_speed + 'ms linear forwards';
    } else {
      progressBar.style.width = '0';
    }
  }

  function pause() {
    hovering = true;
    hero.classList.add('is-paused');
    if (timer) { clearTimeout(timer); timer = null; }
  }

  function resume() {
    hovering = false;
    hero.classList.remove('is-paused');
    restartProgress();
    startTimer();
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); });

  hero.addEventListener('mouseenter', pause);
  hero.addEventListener('mouseleave', resume);
  hero.addEventListener('focusin', pause);
  hero.addEventListener('focusout', function (e) {
    if (!hero.contains(e.relatedTarget)) resume();
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) {
      pause();
    } else {
      hovering = false;
      hero.classList.remove('is-paused');
      restartProgress();
      startTimer();
    }
  });

  container.addEventListener('touchstart', function (e) {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });

  container.addEventListener('touchend', function (e) {
    if (touchStartX === null) return;
    var dx = e.changedTouches[0].clientX - touchStartX;
    touchStartX = null;
    if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1));
  }, { passive: true });

  fetch('/api/slides')
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d && d.success && d.slides && d.slides.length) build(d.slides);
      else build([]);
    })
    .catch(function () { build([]); });
})();
</script>


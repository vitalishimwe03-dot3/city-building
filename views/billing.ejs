<section class="py-5">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
      <div>
        <h1 class="h3 mb-1">Billing &amp; subscription</h1>
        <p class="text-muted mb-0">Manage your free trial, plan and payment history.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/pricing" class="btn btn-outline-primary btn-sm"><i class="bi bi-stars"></i> View plans</a>
        <a href="/account" class="btn btn-outline-secondary btn-sm"><i class="bi bi-person"></i> Account</a>
      </div>
    </div>

    <% if (notice) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert"><%= notice %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
      <% if (req.query.canceled === '1') { %>
        <div class="alert alert-info">Your plan remains active until the end of the current period.</div>
      <% } %>

    <div class="row g-4">
      <div class="col-lg-5">
        <div class="billing-status-card <%= subscription.is_pro ? 'is-pro' : '' %>">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <span class="billing-label">Current plan</span>
              <h2><%= subscription.plan_name || 'Starter' %></h2>
            </div>
            <span class="badge <%= subscription.is_pro ? 'bg-success' : 'bg-secondary' %>"><%= subscription.effective_status || 'free' %></span>
          </div>

          <% if (subscription.is_pro) { %>
            <p class="billing-days"><strong><%= subscription.days_left %></strong> day(s) remaining<% if (subscription.status === 'trialing') { %> in your free trial<% } %></p>
            <% if (subscription.current_period_end) { %>
              <p class="small text-muted mb-2">Renews / ends on <%= new Date(String(subscription.current_period_end).replace(' ', 'T') + 'Z').toLocaleDateString() %></p>
            <% } %>
            <% if (subscription.cancel_at_period_end) { %>
              <div class="alert alert-warning py-2 small mb-3">Cancellation scheduled. You keep access until the end of the period.</div>
              <form method="POST" action="/billing/resume">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-success" type="submit">Keep my plan</button>
              </form>
            <% } else { %>
              <form method="POST" action="/billing/cancel" onsubmit="return confirm('Cancel at the end of the current period? You will keep access until it expires.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-danger" type="submit">Cancel subscription</button>
              </form>
            <% } %>
          <% } else { %>
            <p class="text-muted small">You are on the free Starter plan. Start a 7-day Pro trial to unlock certificates, ad-free browsing and full course tools.</p>
            <% if (!trialUsed) { %>
              <form method="POST" action="/billing/subscribe" class="d-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="planId" value="<%= (plans.find(function(p) { return p.slug === 'pro-monthly'; }) || {}).id %>">
                <button class="btn btn-primary" type="submit"><i class="bi bi-gift"></i> Start 7-day free trial</button>
              </form>
            <% } else { %>
              <a href="/pricing" class="btn btn-primary w-100">Choose a plan</a>
            <% } %>
          <% } %>

          <ul class="billing-features">
            <% (subscription.features || []).forEach(function(feature) { %>
              <li><i class="bi bi-check2"></i> <%= feature %></li>
            <% }); %>
          </ul>
        </div>

        <div class="billing-help-card mt-4">
          <h3 class="h6 fw-bold"><i class="bi bi-phone"></i> Pay by mobile money or bank</h3>
          <p class="small mb-1"><strong>MoMo:</strong> <%= instructions.momoNumber %> (<%= instructions.accountName %>)</p>
          <p class="small mb-1"><strong>Bank:</strong> <%= instructions.bankName %></p>
          <p class="small mb-0"><strong>Account:</strong> <%= instructions.bankAccount %></p>
          <a class="btn btn-sm btn-success mt-3" href="<%= instructions.whatsapp %>?text=Hello%20City%20Building!%20I%20need%20help%20with%20my%20subscription%20payment." target="_blank" rel="noreferrer"><i class="bi bi-whatsapp"></i> Payment help</a>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h5 mb-0">Payment history</h2>
              <span class="badge bg-light text-dark"><%= payments.length %> record(s)</span>
            </div>
            <% if (!payments.length) { %>
              <div class="text-center text-muted py-4"><i class="bi bi-receipt" style="font-size:28px;display:block;margin-bottom:6px;opacity:.5;"></i>No payments yet.</div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                  <thead><tr><th>Date</th><th>Plan</th><th>Amount</th><th>Method</th><th>Status</th></tr></thead>
                  <tbody>
                    <% payments.forEach(function(pay) { %>
                      <tr>
                        <td><small><%= new Date(String(pay.created_at).replace(' ', 'T') + 'Z').toLocaleDateString() %></small></td>
                        <td><%= pay.plan_name %></td>
                        <td><%= formatAmount(pay.amount, pay.currency) %></td>
                        <td><small><%= (pay.method || 'manual').replace(/_/g, ' ') %></small></td>
                        <td>
                          <span class="badge <%= pay.status === 'paid' ? 'bg-success' : (pay.status === 'pending' ? 'bg-warning text-dark' : 'bg-danger') %>"><%= pay.status %></span>
                          <% if (pay.status === 'pending') { %>
                            <a class="small ms-1" href="/billing/checkout/<%= pay.id %>">Complete</a>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card shadow-sm">
          <div class="card-body">
            <h2 class="h5 mb-3">Upgrade your plan</h2>
            <div class="row g-3">
              <% plans.filter(function(p) { return !p.is_free; }).forEach(function(plan) { %>
                <div class="col-md-6">
                  <div class="billing-plan-mini">
                    <div class="d-flex justify-content-between align-items-start">
                      <strong><%= plan.name %></strong>
                      <span class="small text-muted"><%= formatAmount(plan.price_cents, plan.currency) %></span>
                    </div>
                    <p class="small text-muted mb-2"><%= plan.trial_days ? plan.trial_days + '-day free trial' : '6 months access' %></p>
                    <form method="POST" action="/billing/subscribe">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="planId" value="<%= plan.id %>">
                      <button class="btn btn-sm btn-primary w-100" type="submit"><%= plan.trial_days && !trialUsed ? 'Start trial' : 'Choose' %></button>
                    </form>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.billing-status-card { background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: 16px; padding: 22px; }
.billing-status-card.is-pro { border-color: rgba(182,81,52,0.5); box-shadow: 0 12px 32px rgba(182,81,52,0.14); }
.billing-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 700; color: var(--text-muted); }
.billing-status-card h2 { font-size: 1.35rem; font-weight: 800; margin: 4px 0; }
.billing-days { font-size: 14px; color: var(--text-secondary); }
.billing-features { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 7px; }
.billing-features li { font-size: 13px; color: var(--text-secondary); display: flex; gap: 8px; }
.billing-features i { color: var(--accent); }
.billing-help-card { background: var(--bg-secondary); border: 1px solid var(--border-primary); border-radius: 14px; padding: 18px; }
.billing-plan-mini { border: 1px solid var(--border-primary); border-radius: 12px; padding: 14px; background: var(--bg-secondary); height: 100%; }
</style>

<!doctype html>
<html lang="<%= currentLanguage || 'en' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= title || 'City Building Engineering - Professional Software Training in Kigali, Rwanda' %></title>
    <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription !== null ? metaDescription : 'City Building Engineering Company Ltd offers professional software training in Revit, AutoCAD, ETABS, Lumion and more. Enroll in Kigali, Rwanda for career-ready engineering and design courses.' %>">
    <meta name="keywords" content="city building engineering, software training Kigali, Revit course Rwanda, AutoCAD training, ETABS course, engineering courses Rwanda, professional training, BIM training, structural software, rendering courses, Lumion training Rwanda, Civil 3D course, ArchiCAD training">
    <meta name="author" content="City Building Engineering Company Ltd">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : 'https://citybuilding.rw' %>">
    <% if (typeof supportedLanguages !== 'undefined' && supportedLanguages && supportedLanguages.length) { %>
      <% supportedLanguages.forEach(function(lang){ %>
        <link rel="alternate" hreflang="<%= lang %>" href="<%= (typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl.split('?')[0] : ((reqProtocol||'https')+'://'+(reqHost||'citybuilding.rw')+ (currentPath||''))) %>?lang=<%= lang %>">
      <% }); %>
      <link rel="alternate" hreflang="x-default" href="<%= (typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl.split('?')[0] : ((reqProtocol||'https')+'://'+(reqHost||'citybuilding.rw')+ (currentPath||''))) %>">
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="City Building Engineering Company Ltd">
    <meta property="og:title" content="<%= title || 'City Building Engineering - Professional Software Training in Kigali, Rwanda' %>">
    <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription !== null ? metaDescription : 'Professional software training for architecture, engineering, design, and construction careers in Kigali, Rwanda.' %>">
    <meta property="og:image" content="<%= reqProtocol || 'https' %>://<%= reqHost || 'citybuilding.rw' %>/images/logo.png">
    <meta property="og:url" content="<%= canonicalUrl || ((reqProtocol||'https')+'://'+(reqHost||'citybuilding.rw')) %>">
    <meta property="og:locale" content="en_RW">
    <meta property="og:locale:alternate" content="fr_FR">
    <meta property="og:locale:alternate" content="rw_RW">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@citybuilding_rw">
    <meta name="twitter:title" content="<%= title || 'City Building Engineering - Professional Software Training' %>">
    <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription !== null ? metaDescription : 'Professional software training for architecture, engineering, design, and construction careers in Kigali, Rwanda.' %>">
    <meta name="twitter:image" content="<%= reqProtocol || 'https' %>://<%= reqHost || 'citybuilding.rw' %>/images/logo.png">
    <% if (adConfig && adConfig.adsenseEnabled) { %>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-<%= adConfig.adsensePublisherId %>" crossorigin="anonymous"></script>
    <% } %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness", "EducationalOrganization"],
      "@id": "<%= canonicalUrl ? canonicalUrl.split('?')[0].replace(/\/+$/, '') : 'https://citybuilding.rw' %>/#organization",
      "name": "City Building Engineering Company Ltd",
      "url": "<%= canonicalUrl ? canonicalUrl.split('?')[0].replace(/\/+$/, '') : 'https://citybuilding.rw' %>",
      "logo": { "@type": "ImageObject", "url": "<%= reqProtocol || 'https' %>://<%= reqHost || 'citybuilding.rw' %>/images/logo.png" },
      "image": "<%= reqProtocol || 'https' %>://<%= reqHost || 'citybuilding.rw' %>/images/logo.png",
      "description": "Professional software training for architecture, engineering, design, and construction careers in Kigali, Rwanda.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "KG 123 Street, Kigali",
        "addressLocality": "Kigali",
        "addressRegion": "Kigali",
        "addressCountry": "RW"
      },
      "telephone": "+250-789-257-758",
      "email": "citybuildingengineeringcompany@gmail.com",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+250-789-257-758",
        "contactType": "enrollment",
        "availableLanguage": ["English", "French", "Kinyarwanda"]
      },
      "areaServed": "RW",
      "sameAs": [
        "https://wa.me/250789257758",
        "https://www.instagram.com/city_building_engineering_cltd/"
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "<%= canonicalUrl ? canonicalUrl.split('?')[0].replace(/\/+$/, '') : 'https://citybuilding.rw' %>/#website",
      "url": "<%= canonicalUrl ? canonicalUrl.split('?')[0].replace(/\/+$/, '') : 'https://citybuilding.rw' %>",
      "name": "City Building Engineering - Professional Software Training in Kigali, Rwanda",
      "description": "Enroll in professional software training courses in Kigali, Rwanda. Learn Revit, AutoCAD, ETABS, Lumion and more at City Building Engineering Company Ltd.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "<%= reqProtocol || 'https' %>://<%= reqHost || 'citybuilding.rw' %>/?search={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length > 0) { %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        <% breadcrumbs.forEach(function(crumb, i) { %>
        {
          "@type": "ListItem",
          "position": <%= i + 1 %>,
          "name": "<%= crumb.name %>",
          "item": "<%= crumb.url %>"
        }<%= i < breadcrumbs.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    </script>
    <% } %>
    <% if (typeof courseSchema !== 'undefined' && courseSchema) { %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "<%= courseSchema.name %>",
      "description": "<%= courseSchema.description %>",
      "provider": {
        "@type": "Organization",
        "name": "City Building Engineering Company Ltd",
        "sameAs": "<%= reqProtocol || 'https' %>://<%= reqHost || 'citybuilding.rw' %>"
      },
      "educationalCredentialAwarded": "Certificate of Completion",
      "coursePrerequisites": "None",
      "teaches": "<%= courseSchema.teaches || courseSchema.name %>",
      "inLanguage": ["en", "fr", "rw"],
      "audience": {
        "@type": "Audience",
        "audienceType": "<%= courseSchema.audience || 'Architects, Engineers, Designers, Surveyors' %>"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "BlendedLearning",
        "location": {
          "@type": "Place",
          "name": "City Building Engineering Training Center",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Kigali",
            "addressCountry": "RW"
          }
        }
      }
    }
    </script>
    <% } %>
    <% if (typeof faqSchema !== 'undefined' && faqSchema && faqSchema.length > 0) { %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        <% faqSchema.forEach(function(faq, i) { %>
        {
          "@type": "Question",
          "name": "<%= faq.question %>",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<%= faq.answer %>"
          }
        }<%= i < faqSchema.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    </script>
    <% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
    <link rel="shortcut icon" href="/icons/icon-32.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="City Building">
    <meta name="application-name" content="City Building Engineering">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#b65134">
    <% if (process.env.GOOGLE_SITE_VERIFICATION) { %>
    <meta name="google-site-verification" content="<%= process.env.GOOGLE_SITE_VERIFICATION %>">
    <% } %>
    <% if (process.env.BING_SITE_VERIFICATION) { %>
    <meta name="msvalidate.01" content="<%= process.env.BING_SITE_VERIFICATION %>">
    <% } %>
    <script>
    if ('serviceWorker' in navigator) { window.addEventListener('load', function() { navigator.serviceWorker.register('/sw.js').then(function(r) { }, function(e) { }); }); }
    </script>
    <script>(function(){var t=localStorage.getItem('citybuilding-theme');if(!t){t='light'}document.documentElement.setAttribute('data-theme',t)})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/modern-redesign.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/pwa.css">
  </head>

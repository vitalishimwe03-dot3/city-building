        <a href="/billing" class="<%= currentPath && currentPath.startsWith('/billing') ? 'active' : '' %>"><i class="bi bi-credit-card-fill"></i><span>Billing</span></a>
        <a href="/account" class="<%= currentPath && currentPath.startsWith('/account') ? 'active' : '' %>"><i class="bi bi-person-fill"></i><span>Account</span></a>

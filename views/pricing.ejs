<section class="pricing-hero">
  <div class="container">
    <div class="pricing-hero-inner">
      <span class="pricing-eyebrow"><i class="bi bi-rocket-takeoff"></i> Plans &amp; free trial</span>
      <h1>Learn engineering software without limits</h1>
      <p>Start with a <strong>7-day free trial</strong>. Cancel anytime. Pay with MTN MoMo, Airtel Money, bank transfer or card.</p>
      <div class="pricing-hero-badges">
        <span><i class="bi bi-check-circle-fill"></i> 7-day free trial</span>
        <span><i class="bi bi-check-circle-fill"></i> Ad-free learning</span>
        <span><i class="bi bi-check-circle-fill"></i> Certificates included</span>
      </div>
    </div>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <% if (canceled) { %>
      <div class="alert alert-warning text-center">Checkout was canceled. Your card was not charged.</div>
    <% } %>
    <% if (req.query.trial === 'unavailable') { %>
      <div class="alert alert-info text-center">Your free trial is not available on that plan. Choose a paid plan to continue.</div>
    <% } %>
    <% if (req.query.invalid === '1') { %>
      <div class="alert alert-danger text-center">That plan is not available. Please choose another plan.</div>
    <% } %>

    <% if (subscription && subscription.is_pro) { %>
      <div class="alert alert-success d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span><i class="bi bi-patch-check-fill"></i> You are on <strong><%= subscription.plan_name %></strong>
          (<%= subscription.effective_status %>) — <%= subscription.days_left %> day(s) remaining.</span>
        <a href="/billing" class="btn btn-sm btn-outline-success">Manage billing</a>
      </div>
    <% } %>

    <div class="row g-4 align-items-stretch">
      <% plans.forEach(function(plan, index) { %>
        <% var highlighted = plan.slug === 'pro-monthly'; %>
        <div class="col-12 col-md-6 col-xl-3">
          <div class="pricing-card <%= highlighted ? 'pricing-card-featured' : '' %> h-100 d-flex flex-column">
            <% if (highlighted) { %><span class="pricing-ribbon">Most popular</span><% } %>
            <div class="pricing-card-head">
              <h2><%= plan.name %></h2>
              <p><%= plan.description %></p>
            </div>
            <div class="pricing-price">
              <% if (plan.is_free) { %>
                <span class="pricing-amount">Free</span>
              <% } else { %>
                <span class="pricing-amount"><%= formatAmount(plan.price_cents, plan.currency) %></span>
                <span class="pricing-period">/<%= plan.billing_interval === 'one_time' ? '6 months' : plan.billing_interval %></span>
              <% } %>
            </div>
            <% if (plan.trial_days > 0) { %>
              <div class="pricing-trial"><i class="bi bi-gift"></i> <%= plan.trial_days %>-day free trial</div>
            <% } else if (plan.is_free) { %>
              <div class="pricing-trial pricing-trial-muted">No card required</div>
            <% } else { %>
              <div class="pricing-trial pricing-trial-muted">One-time payment</div>
            <% } %>
            <ul class="pricing-features">
              <% plan.features.forEach(function(feature) { %>
                <li><i class="bi bi-check2-circle"></i> <%= feature %></li>
              <% }); %>
            </ul>
            <div class="mt-auto pt-3">
              <% var isCurrent = subscription && subscription.is_pro && subscription.plan_slug === plan.slug; %>
              <% if (isCurrent) { %>
                <a href="/billing" class="btn btn-success w-100">Current plan</a>
              <% } else if (plan.is_free) { %>
                <a href="/services" class="btn btn-outline-secondary w-100">Explore courses</a>
              <% } else if (!siteUser) { %>
                <a href="/login?next=%2Fpricing" class="btn btn-primary w-100">Sign in to choose</a>
              <% } else { %>
                <form method="POST" action="/billing/subscribe">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="planId" value="<%= plan.id %>">
                  <button type="submit" class="btn btn-primary w-100">
                    <% if (plan.trial_days > 0 && !subscription.is_pro) { %>
                      <i class="bi bi-gift"></i> Start free trial
                    <% } else { %>
                      Choose plan
                    <% } %>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="pricing-note mt-4">
      <div class="row g-3 align-items-center">
        <div class="col-lg-8">
          <h3 class="h6 fw-bold mb-1"><i class="bi bi-shield-check"></i> Safe and flexible payments</h3>
          <p class="small text-muted mb-0">Mobile money and bank payments are verified by our team, usually within a few hours. <% if (stripeEnabled) { %>Card checkout is processed securely by Stripe.<% } %> Your free trial can only be used once per account.</p>
        </div>
        <div class="col-lg-4 text-lg-end">
          <a class="btn btn-success" href="https://wa.me/250789257758?text=Hello%20City%20Building!%20I%20have%20a%20question%20about%20plans%20and%20the%20free%20trial." target="_blank" rel="noreferrer"><i class="bi bi-whatsapp"></i> Ask about plans</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="pb-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4"><div class="pricing-faq"><i class="bi bi-gift"></i><h3>How does the trial work?</h3><p>The 7-day trial starts immediately and gives full Pro access. It ends automatically — no charge unless you choose a paid plan.</p></div></div>
      <div class="col-md-4"><div class="pricing-faq"><i class="bi bi-phone"></i><h3>Can I pay with MoMo?</h3><p>Yes. Choose a plan, send the amount to our MoMo number, then submit the transaction reference for verification.</p></div></div>
      <div class="col-md-4"><div class="pricing-faq"><i class="bi bi-x-circle"></i><h3>Can I cancel?</h3><p>Yes. Cancel from your billing page at any time. Your plan stays active until the end of the paid period.</p></div></div>
    </div>
  </div>
</section>

<style>
.pricing-hero { background: linear-gradient(135deg, #0a1628 0%, #0f2a44 55%, #0891b2 140%); color: #fff; padding: 64px 0 56px; }
.pricing-hero-inner { max-width: 820px; margin: 0 auto; text-align: center; }
.pricing-eyebrow { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
.pricing-hero h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; margin: 18px 0 12px; }
.pricing-hero p { color: #cbd5e1; font-size: 1.05rem; max-width: 640px; margin: 0 auto; }
.pricing-hero p strong { color: #fff; }
.pricing-hero-badges { display: flex; flex-wrap: wrap; gap: 10px 22px; justify-content: center; margin-top: 22px; font-size: 13px; color: #e2e8f0; }
.pricing-hero-badges i { color: #34d399; }
.pricing-card { position: relative; background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: 18px; padding: 26px 22px; box-shadow: 0 10px 30px rgba(2, 12, 27, 0.08); transition: transform 0.2s, box-shadow 0.2s; }
.pricing-card:hover { transform: translateY(-4px); box-shadow: 0 18px 44px rgba(2, 12, 27, 0.16); }
.pricing-card-featured { border: 2px solid #0891b2; box-shadow: 0 18px 48px rgba(8, 145, 178, 0.22); }
.pricing-ribbon { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #0891b2, #06b6d4); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; padding: 5px 14px; border-radius: 999px; white-space: nowrap; }
.pricing-card-head h2 { font-size: 1.15rem; font-weight: 800; margin-bottom: 6px; }
.pricing-card-head p { font-size: 13px; color: var(--text-muted); min-height: 56px; margin-bottom: 10px; }
.pricing-price { display: flex; align-items: baseline; gap: 4px; margin: 4px 0 6px; }
.pricing-amount { font-size: 1.65rem; font-weight: 900; color: var(--text-primary); letter-spacing: -0.02em; }
.pricing-period { font-size: 13px; color: var(--text-muted); }
.pricing-trial { font-size: 12px; font-weight: 700; color: #059669; background: rgba(16,185,129,0.12); border-radius: 8px; padding: 6px 10px; display: inline-block; margin-bottom: 12px; }
.pricing-trial-muted { color: var(--text-muted); background: var(--bg-secondary); }
.pricing-features { list-style: none; padding: 0; margin: 0 0 10px; display: grid; gap: 8px; }
.pricing-features li { font-size: 13px; color: var(--text-secondary); display: flex; gap: 8px; align-items: flex-start; }
.pricing-features i { color: #0891b2; margin-top: 2px; }
.pricing-note { background: var(--bg-secondary); border: 1px solid var(--border-primary); border-radius: 16px; padding: 20px 22px; }
.pricing-faq { background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: 14px; padding: 20px; height: 100%; }
.pricing-faq i { font-size: 1.4rem; color: #0891b2; }
.pricing-faq h3 { font-size: 1rem; font-weight: 700; margin: 10px 0 6px; }
.pricing-faq p { font-size: 13px; color: var(--text-muted); margin: 0; }
@media (max-width: 575.98px) { .pricing-card-head p { min-height: 0; } }
</style>
